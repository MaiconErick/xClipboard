<Window x:Class="xClipboard.RefundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:xClipboard"
        Title="Refund info" Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" UseLayoutRounding="True"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
    <Grid Margin="14">
        <Border CornerRadius="16" Background="{DynamicResource Night}">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.65" Color="Black"/></Border.Effect>
        </Border>
        <Border x:Name="Frame" CornerRadius="16" Background="{DynamicResource WindowGrad}" BorderBrush="{DynamicResource Edge}" BorderThickness="1">
            <Grid x:Name="ClipHost">
                <local:AmbientLayer x:Name="Ambient" Opacity="0.6"/>
                <StackPanel Margin="16,10,12,14">
                    <!-- header -->
                    <Grid Background="Transparent" MouseLeftButtonDown="Header_Drag">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="HeaderSprite" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="Refund info" FontFamily="{DynamicResource Display}" FontSize="23" Foreground="{DynamicResource Accent}" VerticalAlignment="Center">
                            <TextBlock.Effect><DropShadowEffect x:Name="TitleGlow" BlurRadius="12" ShadowDepth="0" Opacity="0.55" Color="Black"/></TextBlock.Effect>
                        </TextBlock>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="UndoBtn" Style="{StaticResource IconBtn}" Content="&#xE7A7;" ToolTip="Undo the last auto-fill (Ctrl+Z)" Click="Undo_Click" IsEnabled="False"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE75C;" ToolTip="Clear the sheet for the next refund" Click="Clear_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE921;" ToolTip="Minimize" Click="Min_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="Close (the sheet is kept)" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- listening status -->
                    <Border CornerRadius="9" Background="{DynamicResource Crypt2}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" Padding="10,6" Margin="0,8,4,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Good}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="400"
                                       Text="Listening — copy the order details in any order, they sort themselves"/>
                        </StackPanel>
                    </Border>

                    <!-- fields (built in code) -->
                    <StackPanel x:Name="Rows" Margin="0,0,4,0"/>

                    <!-- bottom bar -->
                    <DockPanel Margin="0,12,4,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Click="RemoveProduct_Click" x:Name="RemoveProductBtn" ToolTip="Remove the last product">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE738;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Product"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Click="AddProduct_Click" Margin="6,0,0,0" ToolTip="Add another product + price">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Product"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ProductCount" DockPanel.Dock="Left" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Click="CopyAll_Click" ToolTip="Copies everything (headings in bold where rich text is supported)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Copy all"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
