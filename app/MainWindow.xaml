<Window x:Class="xClipboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:xClipboard"
        Title="xClipboard" Width="460" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="CardBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="PinBtn" TargetType="Button" BasedOn="{StaticResource CardBtn}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- image previews (copied image, or image files copied in Explorer); hover = big preview -->
        <Style x:Key="ThumbStrip" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type local:ThumbVM}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Edge}" Background="{DynamicResource Night}" Padding="2"
                                    Width="{Binding Width}" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000" ToolTipService.Placement="Right">
                                <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="{Binding Height}" HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border.ToolTip>
                                    <ToolTip Padding="6">
                                        <Image Source="{Binding Image}" MaxWidth="460" MaxHeight="380" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Top" ToolTip="{Binding FullPath}">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Folder}" Foreground="{DynamicResource Muted}" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="{Binding HasFolder, Converter={StaticResource Vis}}"/>
                                <TextBlock Text="{Binding Info}" Foreground="{DynamicResource Faint}" FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClipRow" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ClipTemplate" DataType="{x:Type local:ClipVM}">
            <Grid Margin="0,0,4,0">
                <!-- drop indicator lines for drag reordering -->
                <Border x:Name="DropTop" Height="2" Background="{DynamicResource Accent}" VerticalAlignment="Top" Margin="8,0" Visibility="Collapsed" Panel.ZIndex="2"/>
                <Border x:Name="DropBottom" Height="2" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="8,0" Visibility="Collapsed" Panel.ZIndex="2"/>
                <Border x:Name="Card" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Edge}" Background="{DynamicResource CardBg}"
                        Padding="10,8,6,8" Margin="0,3" Cursor="Hand" AllowDrop="True"
                        PreviewMouseLeftButtonDown="Card_Down" MouseMove="Card_Move" PreviewMouseLeftButtonUp="Card_Up"
                        MouseRightButtonUp="Card_RightClick" DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop">
                    <Grid>
                        <!-- collapsed -->
                        <Grid Visibility="{Binding IsExpanded, Converter={StaticResource NotVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GlyphBox" Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top" Margin="0,1,10,0">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="13.5" Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Visibility="{Binding ShowHeader, Converter={StaticResource Vis}}">
                                    <TextBlock x:Name="TitleText" Text="{Binding DisplayTitle}" Foreground="{DynamicResource Text}" FontSize="13.5"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                                               MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                               Visibility="{Binding HasPreview, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                                <ItemsControl Style="{StaticResource ThumbStrip}" ItemsSource="{Binding Thumbs}"
                                              Visibility="{Binding HasThumbs, Converter={StaticResource Vis}}"/>
                                <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Faint}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasMeta, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource PinBtn}" Content="{Binding PinGlyph}" ToolTip="{Binding PinTip}" Click="Pin_Click"/>
                            <Button Grid.Column="3" Style="{StaticResource CardBtn}" Content="&#xE70D;" ToolTip="Expand to edit (Ctrl+E)" Click="Expand_Click"
                                    Visibility="{Binding CanEdit, Converter={StaticResource Vis}}"/>
                        </Grid>

                        <!-- expanded editor -->
                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource Vis}}" Cursor="Arrow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource Input}" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"
                                         IsVisibleChanged="EditTitle_IsVisibleChanged" MaxLength="200"/>
                                <TextBlock Text="Title (optional)" Foreground="{DynamicResource Faint}" Margin="10,7,0,0" IsHitTestVisible="False"
                                           Visibility="{Binding TitleHintVisible}"/>
                                <Button Grid.Column="1" Style="{StaticResource CardBtn}" Content="&#xE70E;" ToolTip="Collapse (saves)" Click="Collapse_Click" Margin="4,2,0,0"/>
                            </Grid>
                            <Grid Margin="0,6,0,0" Visibility="{Binding CanEditContent, Converter={StaticResource Vis}}">
                                <TextBox Style="{StaticResource Input}" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="260"
                                         VerticalScrollBarVisibility="Auto" FontSize="12.5"/>
                                <TextBlock Text="Content — what gets pasted" Foreground="{DynamicResource Faint}" Margin="10,7,0,0" IsHitTestVisible="False"
                                           Visibility="{Binding TextHintVisible}"/>
                            </Grid>
                            <ItemsControl Style="{StaticResource ThumbStrip}" ItemsSource="{Binding Thumbs}"
                                          Visibility="{Binding HasThumbs, Converter={StaticResource Vis}}"/>
                            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Click="DeleteEdit_Click" Padding="10,5" ToolTip="Delete this clip">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Bad}"/>
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Content="Save" Click="Save_Click" Margin="6,0,0,0" ToolTip="Save (Ctrl+S)"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Cancel" Click="Cancel_Click"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasTitle}" Value="True">
                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRefund}" Value="True">
                    <Setter TargetName="GlyphBox" Property="Background" Value="{DynamicResource AccentGrad}"/>
                    <Setter TargetName="TitleText" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentDeep}"/>
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardSel}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Crypt}"/>
                    <Setter TargetName="Card" Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <!-- shadow lives on its own element so the animated background doesn't re-blur it every frame -->
        <Border CornerRadius="16" Background="{DynamicResource Night}">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.65" Color="Black"/></Border.Effect>
        </Border>
        <Border x:Name="Frame" CornerRadius="16" Background="{DynamicResource WindowGrad}" BorderBrush="{DynamicResource Edge}" BorderThickness="1">
            <Grid x:Name="ClipHost">
                <local:AmbientLayer x:Name="Ambient" Opacity="0.75"/>
                <Grid Margin="14,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- header -->
                    <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="Header_Drag">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="HeaderSprites" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="xClipboard" FontFamily="{DynamicResource Display}" FontSize="23" Foreground="{DynamicResource Accent}" VerticalAlignment="Center">
                                <TextBlock.Effect><DropShadowEffect x:Name="TitleGlow" BlurRadius="12" ShadowDepth="0" Opacity="0.55" Color="Black"/></TextBlock.Effect>
                            </TextBlock>
                            <Border x:Name="PausedBadge" CornerRadius="6" Background="{DynamicResource Bad}" Padding="6,1" Margin="8,2,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="PAUSED" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Night}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE8C7;" ToolTip="Refund info sheet" Click="Refund_Click"/>
                            <Button x:Name="GearBtn" Style="{StaticResource IconBtn}" Content="&#xE713;" ToolTip="Themes &amp; settings" Click="Gear_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="Close (Esc)" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- search -->
                    <Grid Grid.Row="1" Margin="0,8,4,0">
                        <TextBox x:Name="Search" Style="{StaticResource Input}" Padding="30,6,8,6" TextChanged="Search_TextChanged"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Search all tabs…" Foreground="{DynamicResource Faint}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- tabs -->
                    <Grid Grid.Row="2" Margin="0,8,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabScroll_Wheel">
                            <StackPanel x:Name="TabsPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE710;" ToolTip="Add a tab" Click="AddTab_Click" Width="30" Height="30"/>
                    </Grid>

                    <!-- list -->
                    <Grid Grid.Row="3">
                        <ListBox x:Name="List" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource ClipTemplate}"
                                 ItemContainerStyle="{StaticResource ClipRow}" SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 KeyboardNavigation.TabNavigation="Continue" Focusable="False" AllowDrop="True" Drop="List_Drop" DragOver="List_DragOver"/>
                        <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                            <ContentControl x:Name="EmptySprite" HorizontalAlignment="Center" Opacity="0.85"/>
                            <TextBlock x:Name="EmptyTitle" FontFamily="{DynamicResource Display}" FontSize="20" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Faint}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                        </StackPanel>
                    </Grid>

                    <!-- footer -->
                    <DockPanel Grid.Row="4" Margin="0,6,4,0" LastChildFill="True">
                        <Button x:Name="NewBtn" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Click="New_Click" Padding="12,5" ToolTip="New clip in this tab (Ctrl+N)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="New clip"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="Hint" Foreground="{DynamicResource Faint}" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="Enter paste · Ctrl+E edit · Ctrl+P pin · Del delete · right-click for more"/>
                    </DockPanel>
                </Grid>

                <!-- prompt overlay (rename / new tab / confirm) -->
                <Grid x:Name="Prompt" Visibility="Collapsed" Background="#99000000">
                    <Border Background="{DynamicResource Crypt}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="14"
                            Padding="16" Margin="26" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="PromptTitle" FontFamily="{DynamicResource Display}" FontSize="20" Foreground="{DynamicResource Accent}"/>
                            <TextBlock x:Name="PromptText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"/>
                            <TextBox x:Name="PromptInput" Style="{StaticResource Input}" Margin="0,10,0,0" KeyDown="PromptInput_KeyDown"/>
                            <WrapPanel x:Name="PromptChoices" Margin="0,8,0,0"/>
                            <StackPanel x:Name="PromptButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
